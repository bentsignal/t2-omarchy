+/* Diagnostic only: no DMA addresses, buffers, or protocol payloads. */
+static void bce_vhci_log_bulk_out(struct bce_vhci_transfer_queue *q,
+        struct bce_vhci_urb *urb, const char *stage)
+{
+    if (!usb_endpoint_is_bulk_out(&q->endp->desc))
+        return;
+    pr_debug_ratelimited("t2bce_vhci: bulk-out stage=%s port=%d dev=%u ep=%02x urb_state=%d pending=%d active=%u paused_by=%x stalled=%u qstate=%u\n",
+            stage, bce_vhci_transfer_queue_port(q), q->dev_addr, q->endp_addr,
+            urb ? (int)urb->state : -1, atomic_read(&q->sq_out_pending),
+            q->active, q->paused_by, q->stalled, q->state);
+}
