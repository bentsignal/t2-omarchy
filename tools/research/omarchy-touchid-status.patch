+
+  function refreshTouchIdReadiness() {
+    // Clear presentation before asynchronous reads; never reuse a ready cue
+    // from the previous lock or a cache frozen across suspend.
+    touchIdTransportPending = true
+    touchIdScanPending = true
+    touchIdNow = Date.now()
+    touchIdTransportFile.reload()
+    touchIdScanFile.reload()
+  }
+
+  onTouchIdTransportWaitingChanged: {
+    // Only resume a deferred attempt when recovery finishes. Polling the text
+    // must not bypass the lock screen's existing fingerprint retry timer.
+    if (!touchIdTransportWaiting) root.startFingerprint()
+  }
+
+  FileView {
+    id: touchIdTransportFile
+    path: "/run/t2-touchid-ui/transport.json"
+    watchChanges: true
+    printErrors: false
+    onFileChanged: root.refreshTouchIdReadiness()
+    onLoaded: {
+      root.touchIdNow = Date.now()
+      root.touchIdTransport = TouchIdStatus.parse(text())
+      root.touchIdTransportPending = false
+    }
+    onLoadFailed: {
+      root.touchIdTransport = ({})
+      root.touchIdTransportPending = false
+    }
+  }
+
+  FileView {
+    id: touchIdScanFile
+    path: "/run/t2-touchid-ui/scan.json"
+    watchChanges: true
+    printErrors: false
+    onFileChanged: {
+      root.touchIdScanPending = true
+      root.touchIdNow = Date.now()
+      reload()
+    }
+    onLoaded: {
+      root.touchIdNow = Date.now()
+      root.touchIdScan = TouchIdStatus.parse(text())
+      root.touchIdScanPending = false
+    }
+    onLoadFailed: {
+      root.touchIdScan = ({})
+      root.touchIdScanPending = false
+    }
+  }
+
+  Timer {
+    interval: root.lockRequested || root.previewVisible ? 250 : 2000
+    running: true
+    repeat: true
+    onTriggered: {
+      if (root.lockRequested && Date.now() - root.touchIdNow > 1500) {
+        root.refreshTouchIdReadiness()
+        return
+      }
+      root.touchIdNow = Date.now()
+      touchIdTransportFile.reload()
+      touchIdScanFile.reload()
+    }
+  }
