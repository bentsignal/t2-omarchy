# SPDX-License-Identifier: MIT
[Unit]
Description=Queue bounded T2 network recovery after sleep
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=t2-touchid-ui
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /usr/local/libexec/t2_touchid_status.py transport sleeping
ExecStop=/usr/bin/systemctl --no-block start t2-ncm-recover.service

[Install]
WantedBy=sleep.target
