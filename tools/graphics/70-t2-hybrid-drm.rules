# Match DRM card nodes, not connector events. PCI addresses are model-specific.
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ENV{DEVTYPE}=="drm_minor", KERNELS=="0000:00:02.0", SYMLINK+="dri/t2-intel"
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ENV{DEVTYPE}=="drm_minor", KERNELS=="0000:03:00.0", SYMLINK+="dri/t2-amd"
