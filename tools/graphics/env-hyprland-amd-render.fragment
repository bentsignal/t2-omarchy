# T2 hybrid display routing, with AMD as the session-wide default renderer.
# GPU clocks/power policy can change live; rendering-device choice is session startup state.
case " $(cat /proc/cmdline) " in
  *" t2.graphics=hybrid "*)
    export AQ_DRM_DEVICES=/dev/dri/t2-amd:/dev/dri/t2-intel
    export DRI_PRIME=pci-0000_03_00_0
    export MESA_VK_DEVICE_SELECT=1002:7340
    ;;
esac
