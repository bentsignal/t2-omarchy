# SPDX-License-Identifier: MIT
[Unit]
Description=Capture Apple T2 identity count before Linux sensor reset
Documentation=file:/opt/t2-touchid/README.md
After=NetworkManager.service network-online.target
Wants=network-online.target
Before=t2-biometric-ready.service fprintd.service
ConditionPathExists=/etc/t2-touchid.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/t2-warm-identity-capture
RemainAfterExit=yes
StateDirectory=t2-touchid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_LOCAL AF_NETLINK AF_INET6
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
